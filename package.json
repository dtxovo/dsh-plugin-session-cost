{
  "name": "dsh-plugin-session-cost",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: shows the current session's spend, priced by DeepSeek's peak and off-peak rate windows.",
  "license": "MIT",
  "author": "dtxovo",
  "type": "module",
  "main": "host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "check.mjs",
    "check-host.mjs",
    "install.ps1",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs/"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cost",
    "tokens",
    "pricing",
    "billing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtxovo/dsh-plugin-session-cost.git"
  },
  "bugs": {
    "url": "https://github.com/dtxovo/dsh-plugin-session-cost/issues"
  },
  "homepage": "https://github.com/dtxovo/dsh-plugin-session-cost#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node check.mjs",
    "check:host": "node check-host.mjs",
    "prepublishOnly": "node check.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
